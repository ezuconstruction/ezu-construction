---
import Base from '../../layouts/Base.astro';
import Seal from '../../components/Seal.astro';
import { site } from '../../data/site';
---
<Base title="Request received" description="Thanks for contacting EZU Construction." noindex fit>
  <section class="wrap thanks">
    <Seal size={88} />
    <h1>Thanks. We have your request.</h1>
    <p class="lede">We’ll call or email within one business day to set up a time to talk. If it’s urgent, call us at <a href={site.phoneHref}>{site.phone}</a>.</p>
    <p lang="zh-Hans" class="muted">已收到您的咨询，我们会在一个工作日内与您联系。</p>
    <div class="btn-row">
      <a class="btn btn--ghost" href="/projects">Our projects</a>
      <a class="btn btn--ghost" href="/journal">Our guides</a>
    </div>
  </section>
</Base>

<style>
  .thanks { padding-block: clamp(2rem, 1rem + 3vw, 4rem); }
  .thanks h1 { margin-top: 1.5rem; max-width: 16ch; font-size: clamp(2.2rem, 1.4rem + 3vw, 3.75rem); }
  .thanks .lede { margin-bottom: 0.75rem; }
  .thanks .btn-row { margin-top: 1.5rem; }
  @media (max-width: 640px), (max-height: 760px) {
    .thanks { padding-block: 1.25rem; }
    .thanks :global(svg) { width: 56px; height: 56px; }
    .thanks h1 { margin-top: 1rem; font-size: clamp(2rem, 1.4rem + 2vw, 3rem); }
    .thanks .lede { font-size: var(--step-0); }
    .thanks .btn-row { margin-top: 1.1rem; }
  }
</style>
