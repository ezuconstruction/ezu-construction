---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Seal from '../../components/Seal.astro';
import ContactForm from '../../components/ContactForm.astro';
import { Image } from 'astro:assets';
import { services } from '../../data/services';
import { projectBySlug } from '../../data/projects';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';
import { TreeDeciduous, Building, Landmark, Gavel, ArrowRight } from '@lucide/astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ProcessScroll from '../../components/ProcessScroll.astro';
import hero from '../../assets/projects/vaughan-custom-home-kitchen.jpg';

const svcZh: Record<string, string> = {
  'custom-homes': '在您的地块上拆旧建新：可行性评估、图纸、许可证、拆除与施工一站完成。',
  'home-additions': '加建二层、后院扩建、车库改造，让新旧部分看起来浑然一体。',
  'home-renovations': '全屋翻新与格局调整：拆墙开放式改造、电路水管更新、保温与全部饰面。',
  'kitchen-renovations': '按您的烹饪习惯设计厨房，包括中式爆炒厨房（第二厨房）与真正有效的排烟。',
  'bathroom-renovations': '防水做到位、排风做到位：无门槛淋浴、地暖、定制浴室柜。',
  'basement-renovations': '地下室装修与合法出租单元：防水、逃生窗、防火分隔与许可证。',
  'laneway-garden-suites': '后巷屋与花园屋：后院独立小屋，可出租或给家人居住。',
  'trades': '石膏板、地板、瓷砖、油漆、地砖铺装等单项工程，由我们长期合作的专业师傅完成。',
};
const work = [
  { p: projectBySlug('custom-home-construction-vaughan')!, zh: '旺市定制住宅', meta: '新建住宅，旺市' },
  { p: projectBySlug('modern-custom-home-richmond-hill')!, zh: '列治文山现代风格定制住宅', meta: '新建住宅，列治文山' },
  { p: projectBySlug('luxury-kitchen-renovation-toronto')!, zh: '多伦多全屋翻新', meta: '全屋翻新，多伦多' },
  { p: projectBySlug('kitchen-renovation-richmond-hill')!, zh: '列治文山厨房翻新', meta: '厨房翻新，列治文山' },
];
const ba = (slug: string, i: number) => projectBySlug(slug)!.pairs![i];
const comparisons = [
  { title: '多伦多厨房', pair: ba('luxury-kitchen-renovation-toronto', 0), note: '同一个空间、同样的格局，收纳、岛台和饰面全部焕新。', href: '/projects/luxury-kitchen-renovation-toronto' },
  { title: '伯灵顿公寓厨房', pair: ba('apartment-kitchen-renovation', 0), note: '地板从入户一直铺到厨房，整体连贯通透。', href: '/projects/apartment-kitchen-renovation' },
  { title: '地下层游戏室', pair: ba('lakeside-bungalow-whole-home-renovation', 1), note: '闲置的地下层改造成全家人的游戏室。', href: '/projects/lakeside-bungalow-whole-home-renovation' },
  { title: '开放式客餐厅', pair: ba('lakeside-bungalow-whole-home-renovation', 0), note: '封闭的小房间打通为明亮的客餐厅。', href: '/projects/lakeside-bungalow-whole-home-renovation' },
];
const guides = (await getCollection('journal', (a) => a.data.lang === 'zh')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const faqs = [
  { q: '你们可以全程用中文沟通吗？', a: '可以。从第一次电话、上门看房、报价到施工期间的每周进度汇报，都可以用普通话进行。图纸和合同以英文为准，我们会逐条为您解释。' },
  { q: '报价是怎么算的？会不会中途加价？', a: '我们提供书面的分项报价。尚未选定的项目（例如瓷砖、灯具）会以“预留金额”列明，您能清楚看到哪些部分可能变动。任何变更或拆墙后发现的问题，都会先报价、经您书面确认后才施工。' },
  { q: '需要申请建筑许可证吗？', a: '涉及结构、水管、暖通改动、新增卫生间或出租单元的工程，在多伦多、万锦、列治文山和旺市都需要建筑许可证。我们负责申请、配合审图和预约每一次检查。没有许可证的工程在卖房和保险理赔时都会带来麻烦。' },
  { q: '地下室可以合法出租吗？', a: '根据安省 2022 年的新规定，大多数独立屋、半独立屋和镇屋可以合法拥有最多三个住宅单元，而且新增单元免收开发费。地下室出租单元需要独立入口、逃生窗、防火分隔和联动烟雾报警器，并申请许可证。' },
  { q: '工期大概多长？', a: '厨房现场施工一般 5–9 周，浴室 3–5 周，地下室 8–14 周，加建 4–7 个月，定制住宅施工约 10–14 个月，另需加上设计和审批时间。' },
];
---
<Base
  lang="zh"
  title="万锦装修公司 | 多伦多、列治文山、旺市定制住宅与房屋翻新 | EZU Construction"
  description="EZU Construction 是总部位于万锦的家族企业，自 2016 年起在多伦多及约克区建造定制住宅、做房屋加建、全屋翻新、厨房浴室装修与地下室合法出租单元。全程普通话沟通，书面分项报价。"
  image={hero}
  alternate={{ en: '/', zh: '/zh' }}
>
  <section class="wrap hero">
    <div class="copy rise">
      <h1>万锦本地的定制住宅与房屋装修</h1>
      <p class="lede">EZU Construction 是一家总部位于万锦的家族经营总承包商。自 2016 年起，我们在多伦多和约克区建造新房、做加建、全屋翻新、厨房浴室和地下室出租单元。全程可用普通话沟通，一份合同、一个专属项目团队。</p>
      <div class="btn-row">
        <a class="btn" href="#contact">预约上门咨询</a>
        <a class="btn btn--ghost" href={site.phoneHref}>致电 {site.phone}</a>
      </div>
    </div>
    <div class="photo rise-late">
      <Photo src={hero} alt="旺市定制住宅的厨房：通顶玻璃门吊柜、大理石岛台和石材背景墙" priority ratio="4/3" sizes="(min-width: 1000px) 640px, 100vw" caption="我们在旺市建造的定制住宅厨房。" />
    </div>
  </section>

  <section class="section section--plaster">
    <div class="wrap">
      <h2>我们的服务</h2>
      <ul class="svc">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}`} hreflang="en"><ServiceIcon slug={s.slug} /><h3>{s.zh}</h3><p>{svcZh[s.slug]}</p></a></li>
        ))}
      </ul>
      <p class="small muted">服务详情页目前为英文。如需中文说明，欢迎直接来电。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head has-link">
        <div>
          <h2>项目案例</h2>
          <p>我们在大多伦多地区完成的定制住宅与翻新项目。</p>
        </div>
        <a class="btn btn--ghost" href="/projects" hreflang="en">全部项目 <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="work">
        {work.map(({ p, zh, meta }) => (
          <a class="card" href={`/projects/${p.slug}`} hreflang="en">
            <div class="img"><Image src={p.cover.src} alt={zh} widths={[480, 768]} sizes="(min-width: 900px) 280px, 50vw" format="webp" quality={74} /></div>
            <h3>{zh}</h3>
            <p class="muted small">{meta}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--plaster">
    <div class="wrap">
      <div class="section-head"><h2>改造前后对比</h2><p>同一个空间，焕然一新。</p></div>
      <div data-tabs>
        <div class="tablist" role="tablist" aria-label="改造对比">
          {comparisons.map((x, i) => (
            <button type="button" role="tab" id={`zba-tab-${i}`} aria-controls={`zba-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{x.title}</button>
          ))}
        </div>
        {comparisons.map((x, i) => (
          <div role="tabpanel" id={`zba-panel-${i}`} aria-labelledby={`zba-tab-${i}`} tabindex="0">
            <BeforeAfter before={x.pair.before} after={x.pair.after} lang="zh" />
            <p class="ba-cap">{x.note} <a href={x.href} hreflang="en">查看项目（英文）</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section trap-section">
    <div class="wrap"><div class="section-head"><h2>项目流程</h2><p>五个清晰的阶段，从第一次上门到最终验收，由同一个团队负责。</p></div></div>
    <ProcessScroll lang="zh" tone="paper" />
  </section>

  <section class="section section--ink">
    <div class="wrap seal-row">
      <Seal size={120} />
      <div>
        <h2>为什么我们的项目盖章</h2>
        <p>印章代表签名和担当。在安省，工程师在图纸上盖章，表示他对图纸负责。我们也一样：工程完工后，我们的团队陪您逐项验收，整改完毕后签字确认。保修期内的任何问题，也由同一个团队负责跟进。</p>
        <ul class="commit">
          <li>书面分项报价，预留金额逐项列明</li>
          <li>任何变更先报价、经您书面确认再施工</li>
          <li>专属项目团队全程跟进，每周书面汇报进度</li>
          <li>许可证申请与政府检查由我们负责</li>
          <li>电工、燃气等工种由持牌师傅施工</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>动工前要了解的本地规定</h2></div>
      <ul class="features features--2">
        <li><TreeDeciduous size={22} aria-hidden="true" /><div><h3>树木保护条例</h3><p>私人地块上的树木达到一定直径，就需要申请许可证才能砍伐或在根部范围内开挖：多伦多 30 厘米，万锦和旺市 20 厘米，列治文山 15 厘米。</p></div></li>
        <li><Building size={22} aria-hidden="true" /><div><h3>每块地最多三个单元</h3><p>安省 2022 年起允许大多数城市住宅地块拥有最多三个住宅单元（例如主屋、地下室单元和后院花园屋），新增单元免收开发费。</p></div></li>
        <li><Landmark size={22} aria-hidden="true" /><div><h3>历史保护区</h3><p>万锦的 Unionville、Markham Village、Thornhill 和 Buttonville，以及旺市的 Kleinburg、Maple、Thornhill、Woodbridge 都是历史保护区，外立面改动和新建房屋需要额外审批。</p></div></li>
        <li><Gavel size={22} aria-hidden="true" /><div><h3>超出分区限制要听证</h3><p>如果设计超出高度、退界或覆盖率限制，需要向调整委员会（Committee of Adjustment）申请小幅变更，一般多花 3–6 个月。</p></div></li>
      </ul>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section section--plaster">
      <div class="wrap">
        <h2>中文装修指南</h2>
        <ul class="guides">
          {guides.map((g) => <li><a href={`/zh/${g.id.replace(/^zh\//, '')}`}><span class="t">{g.data.title}</span><span class="muted">{g.data.description}</span></a></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap faq-grid">
      <h2>常见问题</h2>
      <div class="faq">
        {faqs.map((f) => <details><summary>{f.q}</summary><div><p>{f.a}</p></div></details>)}
      </div>
    </div>
  </section>

  <section class="section section--plaster" id="contact">
    <div class="wrap contact">
      <div>
        <h2>预约上门咨询</h2>
        <p>留下联系方式和项目简介，我们会在一个工作日内用中文回复您。</p>
        <p><strong><a href={site.phoneHref}>{site.phone}</a></strong><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="muted small">办公室：{site.address.street}, {site.address.city}（万锦）</p>
      </div>
      <ContactForm lang="zh" />
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 2.5rem 4rem; padding-block: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
  @media (min-width: 1000px) { .hero { grid-template-columns: 5fr 6fr; } }
  .hero h1 { font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.5rem); font-weight: 700; }
  .hero .lede { margin-bottom: 2rem; }
  .svc { list-style: none; padding: 0; margin: 1.5rem 0 1rem; display: grid; border-top: 1px solid #c9cdc8; }
  @media (min-width: 760px) { .svc { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; } }
  .svc li { border-bottom: 1px solid #c9cdc8; }
  .svc a { display: grid; grid-template-columns: 2.5rem 1fr; column-gap: 0.75rem; align-content: start; padding: 1.1rem 0; text-decoration: none; }
  .svc :global(.svc-icon) { grid-row: span 2; color: var(--seal); margin-top: 0.1rem; }
  .svc h3 { font-size: var(--step-1); margin-bottom: 0.25rem; }
  .svc p { margin: 0; color: var(--ink-2); }
  .svc a:hover h3 { color: var(--seal); }
  .work { display: grid; gap: 2rem 1.5rem; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .work { grid-template-columns: repeat(4, 1fr); } }
  .card { text-decoration: none; }
  .card .img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--plaster); margin-bottom: 0.7rem; }
  .card .img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .card h3 { font-size: 1.05rem; margin-bottom: 0.15rem; }
  .card:hover h3 { color: var(--seal); }
  .ba-cap { margin: 0.9rem 0 0; color: var(--ink-2); }
  .ba-cap a { color: var(--ink); font-weight: 600; text-decoration-color: var(--seal); }
  .trap-section { padding-bottom: 0; }
  .seal-row { display: grid; gap: 2rem 4rem; align-items: start; }
  @media (min-width: 800px) { .seal-row { grid-template-columns: auto 1fr; } }
  .seal-row p { max-width: 40em; color: #c3c9c4; }
  .seal-row .commit { color: #e3e6e2; }
  .commit { padding-left: 1.2em; margin: 0; }
  .commit li { margin-bottom: 0.3rem; }
  .commit li::marker { color: var(--seal); }
  .guides { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 1px solid #c9cdc8; }
  .guides li { border-bottom: 1px solid #c9cdc8; }
  .guides a { display: grid; gap: 0.2rem; padding: 1.1rem 0; text-decoration: none; }
  .guides .t { font-weight: 700; font-size: var(--step-1); }
  .guides a:hover .t { color: var(--seal); }
  .faq-grid { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: 3fr 9fr; } }
  .contact { display: grid; gap: 2.5rem 5rem; }
  @media (min-width: 960px) { .contact { grid-template-columns: 4fr 8fr; } }
  .contact a { text-decoration-color: var(--seal); }
</style>
