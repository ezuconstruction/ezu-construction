---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Cta from '../../components/Cta.astro';
import { projects } from '../../data/projects';
const order = ['custom-home-construction-vaughan', 'modern-custom-home-richmond-hill', 'custom-home-stone-and-stucco', 'luxury-kitchen-renovation-toronto', 'kitchen-renovation-etobicoke', 'lakeside-bungalow-whole-home-renovation', 'kitchen-renovation-richmond-hill', 'apartment-kitchen-renovation'];
const sorted = [...projects].sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
import PageHero from '../../components/PageHero.astro';
import { Image } from 'astro:assets';
import { projectBySlug } from '../../data/projects';
// Hero collage: the strongest photo from five projects
const collage = [
  { p: 'custom-home-construction-vaughan', src: projectBySlug('custom-home-construction-vaughan')!.cover },
  { p: 'luxury-kitchen-renovation-toronto', src: projectBySlug('luxury-kitchen-renovation-toronto')!.cover },
  { p: 'luxury-kitchen-renovation-toronto', src: projectBySlug('luxury-kitchen-renovation-toronto')!.gallery.find((g) => /ensuite/i.test(g.alt))! },
  { p: 'modern-custom-home-richmond-hill', src: projectBySlug('modern-custom-home-richmond-hill')!.gallery[0] }, // summer view reads better small
  { p: 'kitchen-renovation-etobicoke', src: projectBySlug('kitchen-renovation-etobicoke')!.cover },
];
---
<Base title="Projects: Custom Homes and Renovations We Have Built" description="Real EZU Construction projects: custom homes in Vaughan and Richmond Hill, kitchens across Toronto, and whole-home renovations, with before and after photos.">
  <PageHero title="Projects" lede="Custom homes, kitchens and whole-home renovations completed by our team across the Greater Toronto Area.">
    <div slot="media" class="collage">
      {collage.map((c, i) => (
        <a href={'/projects/' + c.p} tabindex="-1" aria-hidden="true">
          <Image src={c.src.src} alt="" widths={[320, 480, 720]} sizes={i > 2 ? '(min-width: 1000px) 330px, 50vw' : '(min-width: 1000px) 220px, 33vw'} format="webp" quality={72} loading="eager" fetchpriority={i === 3 ? 'high' : 'auto'} />
        </a>
      ))}
    </div>
  </PageHero>
  <section class="wrap grid">
    {sorted.map((p, i) => <ProjectCard project={p} headingLevel="h2" priority={i < 2} sizes="(min-width: 1040px) 560px, (min-width: 700px) 50vw, 100vw" />)}
  </section>
  <Cta title="Looking for something specific?" text="Additional projects and client references are available on request, matched to the scope you’re planning." />
</Base>

<style>
  .grid { display: grid; gap: 3rem 2rem; padding-bottom: var(--space-section); }
  @media (min-width: 700px) { .grid { grid-template-columns: 1fr 1fr; } }
  /* Hero collage: three across the top, two wider below, same 4:3 footprint as other heroes */
  .collage { display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: 1fr 1.3fr; gap: 6px; aspect-ratio: 4 / 3; }
  .collage a { grid-column: span 2; overflow: hidden; background: var(--plaster); }
  .collage a:nth-child(n + 4) { grid-column: span 3; }
  .collage :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .collage a:hover :global(img) { transform: scale(1.03); }
</style>
