---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { locations } from '../../data/locations';
import { areasServed, site } from '../../data/site';
import PageHero from '../../components/PageHero.astro';
import heroImg from '../../assets/projects/custom-home-exterior.jpg';
---
<Base title="Service Areas: Toronto, Markham, Richmond Hill and Vaughan" description="Based in Markham, EZU Construction builds across Toronto and York Region, including Richmond Hill, Vaughan, North York, Scarborough and Etobicoke.">
  <PageHero title="Where we build" lede={`EZU Construction serves the GTA, with our office headquartered at ${site.address.street} in ${site.address.city}.`} image={heroImg} imageAlt="Two-storey custom home with a stone facade on an established street" caption="One of our custom homes in the GTA." />

  <section class="wrap cities">
    {locations.map((l) => (
      <a href={`/locations/${l.slug}`} class="city">
        <h2>{l.name} <span lang="zh-Hans" class="zh">{l.zh}</span></h2>
        <p>{l.lede}</p>
        <p class="small muted">{l.neighbourhoods.slice(0, 6).join(', ')}</p>
      </a>
    ))}
  </section>

  <section class="section section--ink">
    <div class="wrap also">
      <h2>We also work in</h2>
      <p>{areasServed.filter((a) => !locations.some((l) => l.name === a)).join(', ')}, and further afield for the right project. Our <a href="/projects/lakeside-bungalow-whole-home-renovation">lakeside bungalow</a> in Carrying Place is one example.</p>
      <p>Not sure if you’re in range? <a href="/contact">Send us your address</a> and we’ll tell you.</p>
    </div>
  </section>
  <Cta />
</Base>

<style>
  .cities { display: grid; gap: 0 3rem; padding-bottom: var(--space-section); }
  @media (min-width: 800px) { .cities { grid-template-columns: 1fr 1fr; } }
  .city { display: block; padding: 1.75rem 0; border-top: 1px solid var(--line); text-decoration: none; }
  .city h2 { font-size: var(--step-3); margin-bottom: 0.5rem; }
  .city:hover h2 { color: var(--seal); }
  .zh { display: block; margin-top: 0.3rem; font-stretch: 100%; font-weight: 500; font-size: 0.55em; color: var(--ink-2); }
  .city p { color: var(--ink-2); max-width: 50ch; margin-bottom: 0.5rem; }
  .also { max-width: 62ch; }
  .also a { color: #fff; text-decoration-color: var(--seal); }
  .also p { color: #c3c9c4; }
</style>
