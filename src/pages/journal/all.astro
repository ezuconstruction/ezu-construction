---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleList from '../../components/ArticleList.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('journal', (a) => a.data.lang === 'en')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="All Articles: Renovation and Building Guides" description="Every EZU Construction guide on renovation and building costs, timelines, permits and design for GTA homeowners, newest first." switchTo="/zh/guides">
  <PageHero crumbs={[{ href: '/journal', label: 'Journal' }, { label: 'All articles' }]} title="All articles" lede={`All ${all.length} of our guides for GTA homeowners, newest first.`} />
  <section class="wrap list">
    <ArticleList items={all} />
  </section>
  <Cta title="Have a question we haven’t answered?" text="Ask us. If it’s a question other homeowners are likely to have, we may write the answer up here too." />
</Base>

<style>
  .list { padding-bottom: var(--space-section); }
</style>
