---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import Seal from '../../components/Seal.astro';
import ArticleList from '../../components/ArticleList.astro';
import Cta from '../../components/Cta.astro';
import { serviceBySlug } from '../../data/services';
import { site } from '../../data/site';
import { Info } from '@lucide/astro';

export async function getStaticPaths() {
  const all = await getCollection('journal', (a) => a.data.lang === 'en');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: CollectionEntry<'journal'>; all: CollectionEntry<'journal'>[] }
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const mentionsPrices = /\$\d/.test(entry.body ?? '');
const fmt = (x: Date) => x.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const related = all
  .filter((a) => a.id !== entry.id)
  .map((a) => ({ a, score: a.data.services.filter((s) => d.services.includes(s)).length + (a.data.category === d.category ? 0.5 : 0) }))
  .sort((x, y) => y.score - x.score || y.a.data.date.valueOf() - x.a.data.date.valueOf())
  .slice(0, 3)
  .map((x) => x.a);
const svc = d.services.map((s) => serviceBySlug(s)).filter(Boolean);
const url = new URL(`/journal/${entry.id}`, site.url).href;
const ldImage = await getImage({ src: d.image, width: 1200, format: 'jpeg', quality: 80 });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  image: new URL(ldImage.src, 'https://ezuconstruction.ca').href,
  description: d.description,
  datePublished: d.date.toISOString().slice(0, 10),
  dateModified: (d.updated ?? d.date).toISOString().slice(0, 10),
  mainEntityOfPage: url,
  author: { '@id': `${site.url}/#org` },
  publisher: { '@id': `${site.url}/#org` },
  inLanguage: 'en-CA',
};
---
<Base title={d.seoTitle ?? d.title} description={d.description} image={d.image} type="article" jsonld={ld}>
  <article class="wrap article">
    <header class="head rise">
      <Breadcrumbs items={[{ href: '/journal', label: 'Journal' }, { label: d.title }]} />
      <p class="meta"><span class="cat">{d.category}</span> <time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time>{d.updated && <> (updated <time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time>)</>}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </header>

    <Photo src={d.image} alt={d.imageAlt} caption={d.imageCaption} priority sizes="(min-width: 1240px) 1160px, 100vw" ratio="16/8" class="cover rise-late" />

    <div class="body">
      <div class="prose">
        {mentionsPrices && (
          <p class="note"><Info size={20} aria-hidden="true" /><span>The prices in this guide are rough ranges to help you plan, not quotes. Every house and every set of choices is different. Your price comes from a written quote after we’ve seen the house.</span></p>
        )}
        <Content />
        <footer class="signoff">
          <Seal size={44} />
          <p>Written by the EZU Construction team, serving the GTA region. <a href="/contact">Contact us</a> for your next construction project.</p>
        </footer>
      </div>
      {svc.length > 0 && (
        <aside class="aside" aria-label="Related services">
          <p class="aside-title">Planning a project like this?</p>
          <ul>{svc.map((s) => <li><a href={`/services/${s!.slug}`}>{s!.name}</a></li>)}</ul>
          <a class="btn" href="/contact">Book a consultation</a>
          <p class="small muted">Or call <a href={site.phoneHref}>{site.phone}</a></p>
        </aside>
      )}
    </div>
  </article>

  <section class="section">
    <div class="wrap">
      <h2 class="rel-title">More guides</h2>
      <ArticleList items={related} />
    </div>
  </section>
  <Cta />
</Base>

<style>
  .article { padding-top: var(--page-top); }
  .head { max-width: 52rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: var(--step--1); color: var(--ink-2); margin-bottom: 1rem; }
  .cat { color: var(--seal); font-weight: 600; }
  .head h1 { font-size: var(--step-4); }
  .head .lede { margin-bottom: 2.5rem; }
  .article :global(.cover) { margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .body { display: grid; gap: 3rem; }
  @media (min-width: 1040px) { .body { grid-template-columns: minmax(0, 1fr) 17rem; gap: 5rem; } }
  .prose { font-size: 1.0625rem; line-height: 1.7; }
  @media (min-width: 900px) { .prose { font-size: 1.125rem; } }
  .aside { align-self: start; position: sticky; top: 6.5rem; padding-top: 1rem; border-top: 2px solid var(--ink); }
  .aside-title { font-weight: 650; font-stretch: 75%; font-size: var(--step-2); margin-bottom: 0.75rem; }
  .aside ul { list-style: none; padding: 0; margin: 0 0 1.25rem; }
  .aside li { margin-bottom: 0.4rem; }
  .aside li a { text-decoration-color: var(--seal); }
  .aside .small { margin-top: 0.75rem; }
  @media (max-width: 1039px) { .aside { position: static; } }
  .signoff { display: flex; gap: 1rem; align-items: flex-start; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--ink-2); }
  .signoff p { margin: 0; }
  .rel-title { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .note { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; margin: 0 0 2rem; padding: 1rem 1.25rem; background: var(--plaster); border-left: 3px solid var(--seal); font-size: var(--step--1); line-height: 1.55; }
  .note :global(svg) { color: var(--seal); margin-top: 0.1rem; }
</style>
