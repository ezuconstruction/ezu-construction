---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';

export async function getStaticPaths() {
  const all = await getCollection('journal', (a) => a.data.lang === 'en');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: CollectionEntry<'journal'>; all: CollectionEntry<'journal'>[] }
---
<ArticlePage {...Astro.props} />
