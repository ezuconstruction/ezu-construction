---
import Base from '../../layouts/Base.astro';
import ProcessScroll from '../../components/ProcessScroll.astro';
import Photo from '../../components/Photo.astro';
import DimensionLine from '../../components/DimensionLine.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleList from '../../components/ArticleList.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Cta from '../../components/Cta.astro';
import { CircleCheck, Info, Phone, Timer, FileText, ClipboardCheck, Languages, MessageSquare } from '@lucide/astro';
import { services, type Service } from '../../data/services';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
interface Props { s: Service }
const { s } = Astro.props;
const work = projects.filter((p) => p.service === s.slug || (s.slug === 'bathroom-renovations' && p.slug === 'apartment-kitchen-renovation'));
const guides = (await getCollection('journal', (a) => a.data.lang === 'en' && s.articles.includes(a.id)))
  .sort((a, b) => s.articles.indexOf(a.id) - s.articles.indexOf(b.id));
const others = services.filter((o) => o.slug !== s.slug);
// One-line descriptions for the Other services cards
const cardLine: Record<string, string> = {
  'custom-homes': 'New homes built on your lot.',
  'home-additions': 'Second storeys and rear extensions.',
  'home-renovations': 'New layouts for the whole house.',
  'kitchen-renovations': 'Kitchens planned around how you cook.',
  'bathroom-renovations': 'Waterproofed, ventilated, built to last.',
  'basement-renovations': 'Finished basements and legal suites.',
  'laneway-garden-suites': 'Backyard homes for family or rental.',
  'trades': 'Flooring, tile, drywall and paint.',
};
const workTitle: Record<string, string> = {
  'custom-homes': 'Custom homes we’ve built',
  'kitchen-renovations': 'Kitchens we’ve built',
  'bathroom-renovations': 'Bathrooms we’ve built',
  'home-renovations': 'Whole-home renovations we’ve done',
};
const weeks = s.timeline ? [s.timeline.reduce((a, t) => a + t.weeks[0], 0), s.timeline.reduce((a, t) => a + t.weeks[1], 0)] : null;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  description: s.description,
  provider: { '@id': `${site.url}/#org` },
  areaServed: ['Toronto', 'Markham', 'Richmond Hill', 'Vaughan'].map((name) => ({ '@type': 'City', name })),
  url: new URL(`/services/${s.slug}`, site.url).href,
};
import PageHero from '../../components/PageHero.astro';
---
<Base title={s.title} description={s.description} image={s.image} jsonld={ld}>
  <PageHero crumbs={[{ href: '/services', label: 'Services' }, { label: s.name }]} title={s.name} lede={s.short} image={s.image} imageAlt={s.imageAlt} caption={s.imageIsProject ? 'A finished EZU project.' : undefined} icon={s.slug}>
    <div class="btn-row">
      <a class="btn" href={`/contact?service=${s.slug}`}>Book a consultation</a>
      <a class="btn btn--ghost" href={site.phoneHref}><Phone size={18} aria-hidden="true" />Call {site.phone}</a>
    </div>
  </PageHero>

  <section class="section intro-section">
    <div class="wrap intro-grid">
      <div class="intro-main">
        <div class="prose">
          {s.intro.map((p) => <p>{p}</p>)}
        </div>
        <Photo class="intro-pic" src={s.introImage.src} alt={s.introImage.alt} caption={s.introImage.caption} ratio="3/2" sizes="(min-width: 1000px) 700px, 100vw" />
      </div>
      <aside class="glance" aria-label="At a glance">
        <ul>
          {weeks && <li><Timer size={20} aria-hidden="true" /><span><strong>{weeks[0]}–{weeks[1]} weeks</strong> from first meeting to finish, for a typical project</span></li>}
          <li><FileText size={20} aria-hidden="true" /><span><strong>A written, itemized quote</strong> after we’ve seen the house</span></li>
          <li><ClipboardCheck size={20} aria-hidden="true" /><span><strong>Permits and inspections</strong> handled by us</span></li>
          <li><Languages size={20} aria-hidden="true" /><span><strong>English or Mandarin</strong>, whichever suits your family</span></li>
        </ul>
        <p class="price-h">How it’s priced</p>
        <p class="price">{s.price}</p>
      </aside>
    </div>
  </section>

  <section class="section section--plaster">
    <div class="wrap">
      <div class="section-head"><h2>What we take care of</h2><p>All of it under one contract, managed by a dedicated project team.</p></div>
      <ul class="features">
        {s.includes.map((i) => <li><CircleCheck size={22} aria-hidden="true" /><div><h3>{i.title}</h3><p>{i.body}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="section trap-section">
    <div class="wrap"><div class="section-head"><h2>How your project runs</h2><p>Five defined stages, from the first site visit to final sign-off.</p></div></div>
    <ProcessScroll tone="paper" finish={{ src: s.band.src, alt: s.band.alt }} />
  </section>

  {s.timeline && (
    <section class="section section--plaster">
      <div class="wrap">
        <div class="section-head"><h2>How long it takes</h2><p>Typical for this kind of project in the GTA. Permits are the least predictable part, especially if a variance is needed.</p></div>
        <DimensionLine phases={s.timeline} />
      </div>
    </section>
  )}

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head"><h2>Good to know before you start</h2></div>
      <ul class="features">
        {s.know.map((k) => <li><Info size={22} aria-hidden="true" /><div><h3>{k.title}</h3><p>{k.body}</p></div></li>)}
      </ul>
    </div>
  </section>

  {work.length > 0 && (
    <section class="section section--plaster">
      <div class="wrap">
        <div class="section-head"><h2>{workTitle[s.slug] ?? 'Related projects'}</h2></div>
        <div class="cards">{work.map((p) => <ProjectCard project={p} />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap faq-grid">
      <h2>Common questions</h2>
      <div class="faq">
        {s.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p>{f.cta && <p class="faq-cta"><a class="text-link" href={`/contact?service=${s.slug}`}>{f.cta}</a></p>}</div>
          </details>
        ))}
        <div class="faq-more">
          <p><strong>Have a question we didn’t cover?</strong> Our team is happy to talk it through.</p>
          <div class="btn-row">
            <a class="btn" href={`/contact?service=${s.slug}`}>Ask us</a>
            <a class="btn btn--ghost" href={site.phoneHref}><Phone size={18} aria-hidden="true" />Call {site.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section section--plaster section--tight">
      <div class="wrap">
        <h2 class="guides-title">Further reading</h2>
        <ArticleList items={guides} />
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="wrap">
      <h2 class="other-title">Other services</h2>
      <ul class="other">
        {others.map((o) => (
          <li><a href={`/services/${o.slug}`}><ServiceIcon slug={o.slug} size={28} /><span class="o-name">{o.name}</span><span class="o-text">{cardLine[o.slug]}</span></a></li>
        ))}
        <li><a class="o-cta" href={'/contact?service=' + s.slug}><MessageSquare size={28} aria-hidden="true" /><span class="o-name">Not sure which you need?</span><span class="o-text">Tell us your plans and we’ll advise.</span></a></li>
      </ul>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .intro-section { padding-top: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .intro-grid { display: grid; gap: 2.5rem 5rem; }
  @media (min-width: 1000px) { .intro-grid { grid-template-columns: minmax(0, 1fr) 22rem; } }
  .intro-grid .prose { font-size: var(--step-1); line-height: 1.6; max-width: 62ch; }
  .glance { align-self: start; background: var(--plaster); border-top: 3px solid var(--seal); padding: 1.5rem; }
  .glance ul { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: 0.9rem; }
  .glance li { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; align-items: start; line-height: 1.45; }
  .glance li :global(svg) { color: var(--seal); margin-top: 0.1rem; }
  .glance strong { font-weight: 650; }
  .price-h { margin: 0 0 0.3rem; padding-top: 1rem; border-top: 1px solid #d3d6d1; font-weight: 650; }
  .price { margin: 0; color: var(--ink-2); font-size: var(--step--1); line-height: 1.55; }
  .cards { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .trap-section { padding-bottom: 0; }
  .intro-main :global(.intro-pic) { margin-top: 2rem; max-width: var(--measure); }
  .faq-grid { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: 4fr 8fr; } }
  .guides-title { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .faq-cta { margin-top: 0.75rem !important; }
  .faq-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 2rem; padding: 1.25rem 1.5rem; background: var(--plaster); border-radius: var(--radius); }
  .faq-more p { margin: 0; text-wrap: balance; }
  .other-title { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .other { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .other { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .other { grid-template-columns: repeat(4, 1fr); } }
  .other a {
    display: grid; gap: 0.5rem; align-content: start; height: 100%; padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid #c9cdc8; border-radius: var(--radius); text-decoration: none; background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .other a :global(svg) { color: var(--seal); margin-bottom: 0.35rem; }
  .other .o-name { font-size: var(--step-1); font-weight: 650; line-height: 1.25; text-wrap: balance; }
  .other .o-text { color: var(--ink-2); font-size: var(--step-1); line-height: 1.4; text-wrap: balance; }
  .other a:hover { border-color: var(--seal); box-shadow: 0 8px 20px -12px rgba(30, 35, 38, 0.35); transform: translateY(-2px); }
  .other a:hover .o-name { color: var(--seal); }
  .other .o-cta { background: var(--plaster); border-color: var(--plaster); }
</style>
