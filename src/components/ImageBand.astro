---
// A full-width photograph between sections. Breaks up long pages and shows the work at scale.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; position?: string }
const { src, alt, caption, position = 'center' } = Astro.props;
const widths = [768, 1280, 1920].filter((w) => w <= src.width);
if (!widths.length) widths.push(src.width);
---
<figure class="band">
  <Image src={src} alt={alt} widths={widths} sizes="100vw" format="webp" quality={74} loading="lazy" style={`object-position:${position}`} />
  {caption && <figcaption><span>{caption}</span></figcaption>}
</figure>

<style>
  .band { position: relative; height: clamp(240px, 38vw, 560px); overflow: hidden; background: var(--plaster); }
  .band :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { position: absolute; left: 0; right: 0; bottom: 1rem; margin: 0; }
  figcaption span {
    display: inline-block; margin-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    background: #fff; color: var(--ink); padding: 0.5rem 0.9rem; border-radius: var(--radius);
    font-size: var(--step-0);
  }
</style>
