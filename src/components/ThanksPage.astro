---
// One template for /contact/thanks and /zh/contact/thanks (where the contact form returns).
import Base from '../layouts/Base.astro';
import Seal from './Seal.astro';
import { site } from '../data/site';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const t = zh
  ? { title: '已收到您的咨询', description: '感谢您联系 EZU Construction。', h1: '谢谢，我们已收到您的咨询。', lede: '我们会在一个工作日内用中文致电或发邮件给您，约时间详谈。如有急事，请致电', projects: '项目案例', guides: '中文指南', pre: '/zh', guidesHref: '/zh/guides' }
  : { title: 'Request received', description: 'Thanks for contacting EZU Construction.', h1: 'Thanks. We have your request.', lede: 'We’ll call or email within one business day to set up a time to talk. If it’s urgent, call us at', projects: 'Our projects', guides: 'Our guides', pre: '', guidesHref: '/journal' };
---
<Base lang={lang} title={t.title} description={t.description} noindex fit alternate={{ en: '/contact/thanks', zh: '/zh/contact/thanks' }}>
  <section class="wrap thanks">
    <Seal size={88} />
    <h1>{t.h1}</h1>
    <p class="lede">{t.lede} <a href={site.phoneHref}>{site.phone}</a>{zh ? '。' : '.'}</p>
    <div class="btn-row">
      <a class="btn btn--ghost" href={`${t.pre}/projects`}>{t.projects}</a>
      <a class="btn btn--ghost" href={t.guidesHref}>{t.guides}</a>
    </div>
  </section>
</Base>

<style>
  .thanks { padding-block: clamp(2rem, 1rem + 3vw, 4rem); }
  .thanks h1 { margin-top: 1.5rem; max-width: 16ch; font-size: clamp(2.2rem, 1.4rem + 3vw, 3.75rem); }
  .thanks .lede { margin-bottom: 0.75rem; }
  .thanks .btn-row { margin-top: 1.5rem; }
  @media (max-width: 640px), (max-height: 760px) {
    .thanks { padding-block: 1.25rem; }
    .thanks :global(svg) { width: 56px; height: 56px; }
    .thanks h1 { margin-top: 1rem; font-size: clamp(2rem, 1.4rem + 2vw, 3rem); }
    .thanks .lede { font-size: var(--step-0); }
    .thanks .btn-row { margin-top: 1.1rem; }
  }
</style>
