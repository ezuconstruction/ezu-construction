---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { project: Project; sizes?: string; priority?: boolean; headingLevel?: 'h2' | 'h3'; feature?: boolean }
const { project: p, sizes = '(min-width: 1000px) 380px, (min-width: 640px) 50vw, 100vw', priority = false, headingLevel = 'h3', feature = false } = Astro.props;
const H = headingLevel;
const meta = p.location.replace(', Ontario', '');
---
<article class:list={['project-card', { feature }]}>
  <a href={`/projects/${p.slug}`}>
    <div class="img">
      <Image src={p.cover.src} alt={p.cover.alt} widths={[480, 768, 1080]} sizes={sizes} format="webp" quality={76} loading={priority ? 'eager' : 'lazy'} />
    </div>
    <H class="name">{p.title}</H>
    <p class="meta">{p.type} in {meta}</p>
  </a>
</article>

<style>
  .project-card a { display: block; text-decoration: none; }
  @media (min-width: 1000px) {
    .feature, .feature a { height: 100%; }
    .feature a { display: flex; flex-direction: column; }
    .feature .img { flex: 1; aspect-ratio: auto; min-height: 22rem; }
  }
  .img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--plaster); margin-bottom: 0.9rem; }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .project-card a:hover :global(img) { transform: scale(1.02); }
  .name { font-size: var(--step-2); margin: 0 0 0.3rem; }
  .project-card a:hover .name { color: var(--seal); }
  .meta { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  @media (prefers-reduced-motion: reduce) { .img :global(img) { transition: none; } }
</style>
