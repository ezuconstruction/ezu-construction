---
// Responsive WebP image. WebP over AVIF on purpose: it decodes much faster on low-end phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  priority?: boolean;
  ratio?: string; // e.g. "4/3" crops via object-fit
  class?: string;
}
const { src, alt, caption, sizes = '(min-width: 1240px) 1160px, 100vw', priority = false, ratio, class: cls } = Astro.props;
const widths = [480, 768, 1080, 1440, 1920].filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 1920) widths.push(src.width);
---
<figure class:list={['photo', cls]}>
  <div class="frame" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .frame { overflow: hidden; background: var(--plaster); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
