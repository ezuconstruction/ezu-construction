---
// One hero for every inner page, so headings, spacing and photos line up site-wide.
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import ServiceIcon from './ServiceIcon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  crumbs?: { href?: string; label: string }[]; // omit on top-level pages
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  caption?: string;
  icon?: string; // service slug
}
const { crumbs, title, lede, image, imageAlt = '', caption, icon } = Astro.props;
const media = Astro.slots.has('media'); // custom right-hand visual instead of a single photo
---
<section class:list={['wrap', 'page-hero', { 'has-image': image || media }]}>
  {crumbs && <Breadcrumbs items={crumbs} />}
  <div class="grid">
    <div class="copy rise">
      {icon && <ServiceIcon slug={icon} size={44} class="hero-icon" />}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {media && <div class="pic rise-late"><slot name="media" /></div>}
    {image && !media && (
      <div class="pic rise-late">
        <Photo src={image} alt={imageAlt} priority ratio="4/3" sizes="(min-width: 1000px) 640px, 100vw" />
        {caption && <span class="chip">{caption}</span>}
      </div>
    )}
  </div>
</section>

<style>
  .page-hero { padding-block: var(--page-top) clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .grid { display: grid; gap: 2.5rem 4rem; align-items: center; }
  .has-image .grid { grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .has-image .grid { grid-template-columns: 5fr 6fr; } }
  .copy :global(.hero-icon) { color: var(--seal); margin-bottom: 1rem; }
  h1 { font-size: clamp(2.6rem, 1.4rem + 3.4vw, 4.25rem); line-height: 0.98; letter-spacing: -0.02em; max-width: 14ch; }
  .lede { margin: 0; }
  .pic { position: relative; }
  .chip { position: absolute; left: 0.75rem; bottom: 0.75rem; max-width: calc(100% - 1.5rem); background: #fff; color: var(--ink); padding: 0.45rem 0.85rem; border-radius: var(--radius); font-size: var(--step-0); line-height: 1.35; }
  .copy > :global(.btn-row), .copy > :global(.btn), .copy > :global(.jump) { margin-top: 2rem; }
</style>
