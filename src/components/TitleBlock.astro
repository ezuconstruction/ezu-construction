---
// Project facts laid out like the title block on a drawing sheet.
interface Props { rows: { label: string; value: string }[] }
const { rows } = Astro.props;
---
<dl class="title-block">
  {rows.map((r) => (
    <div><dt>{r.label}</dt><dd>{r.value}</dd></div>
  ))}
</dl>

<style>
  .title-block {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    margin: 0; border-top: 2px solid var(--ink); border-left: 1px solid var(--line);
  }
  .title-block div { padding: 0.75rem 0.9rem 0.85rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  dt { font-size: var(--step--1); color: var(--ink-2); margin-bottom: 0.15rem; }
  dd { margin: 0; font-weight: 600; line-height: 1.3; }
</style>
