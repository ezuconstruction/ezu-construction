---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'journal'>[]; base?: string; cols?: boolean; compact?: boolean }
const { items, base = '/journal', cols = false, compact = false } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<ul class:list={['article-list', { cols, compact }]}>
  {items.map((a) => (
    <li>
      <a href={`${base}/${a.id}`}>
        <span class="thumb"><Image src={a.data.image} alt="" widths={[240, 400]} sizes="(min-width: 860px) 200px, 112px" format="webp" quality={70} /></span>
        <span class="text">
          <span class="cat">{a.data.category}</span>
          <span class="t">{a.data.title}</span>
          <span class="d">{a.data.description}</span>
        </span>
        <time datetime={a.data.date.toISOString().slice(0, 10)}>{fmt(a.data.date)}</time>
      </a>
    </li>
  ))}
</ul>

<style>
  .article-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .article-list li { border-bottom: 1px solid var(--line); }
  .article-list a { display: grid; grid-template-columns: 7rem 1fr; gap: 0.25rem 1.25rem; padding: 1.25rem 0; text-decoration: none; align-items: start; }
  .thumb { grid-row: span 2; aspect-ratio: 4 / 3; overflow: hidden; background: var(--plaster); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .text { display: grid; gap: 0.3rem; }
  time { grid-column: 2; font-size: var(--step--1); color: var(--ink-2); }
  @media (min-width: 860px) {
    .article-list a { grid-template-columns: 12.5rem 1fr 9rem; gap: 0 2rem; }
    .thumb { grid-row: auto; }
    time { grid-column: auto; text-align: right; padding-top: 0.2rem; }
  }
  .cat { font-size: var(--step--1); color: var(--seal-dark); font-weight: 600; }
  .t { font-size: var(--step-2); font-stretch: 75%; font-weight: 650; line-height: 1.12; text-wrap: balance; }
  .d { color: var(--ink-2); max-width: 60ch; }
  @media (max-width: 859px) { .d { display: none; } .t { font-size: var(--step-1); } }
  .article-list a:hover .t { color: var(--seal); }
  /* Compact variant (narrow columns): thumbnail beside the title, no description */
  .article-list.compact a { grid-template-columns: 7.5rem 1fr; gap: 0.3rem 1.25rem; }
  .article-list.compact .thumb { grid-row: span 2; }
  .article-list.compact time { grid-column: 2; text-align: left; padding-top: 0; }
  .article-list.compact .d { display: none; }
  .article-list.compact .t { font-size: var(--step-1); }
  /* Two-column variant (homepage): image beside the text, date under the title */
  @media (min-width: 860px) {
    .article-list.cols { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; }
    .article-list.cols a { grid-template-columns: 11rem 1fr; gap: 0.35rem 1.5rem; }
    .article-list.cols .thumb { grid-row: span 2; }
    .article-list.cols time { grid-column: 2; text-align: left; padding-top: 0; }
    .article-list.cols .d { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  }
</style>
