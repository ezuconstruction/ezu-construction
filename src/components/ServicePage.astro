---
// One template for /services/[slug] and /zh/services/[slug]; the zh route passes a service with Chinese text.
import Base from '../layouts/Base.astro';
import ProcessScroll from './ProcessScroll.astro';
import Photo from './Photo.astro';
import DimensionLine from './DimensionLine.astro';
import ProjectCard from './ProjectCard.astro';
import ArticleList from './ArticleList.astro';
import ServiceIcon from './ServiceIcon.astro';
import PageHero from './PageHero.astro';
import Cta from './Cta.astro';
import { CircleCheck, Info, Phone, Timer, FileText, ClipboardCheck, Languages, MessageSquare } from '@lucide/astro';
import { services, type Service } from '../data/services';
import { servicesZh } from '../data/zh';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

interface Props { s: Service; lang?: 'en' | 'zh' }
const { s, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const work = projects.filter((p) => p.service === s.slug || (s.slug === 'bathroom-renovations' && p.slug === 'apartment-kitchen-renovation'));
const guides = (await getCollection('journal', (a) => a.data.lang === lang && s.articles.includes(a.id)))
  .sort((a, b) => s.articles.indexOf(a.id) - s.articles.indexOf(b.id));
const others = services.filter((o) => o.slug !== s.slug);
// One-line descriptions for the Other services cards
const cardLine: Record<string, string> = {
  'custom-homes': 'New homes built on your lot.',
  'home-additions': 'Second storeys and rear extensions.',
  'home-renovations': 'New layouts for the whole house.',
  'kitchen-renovations': 'Kitchens planned around how you cook.',
  'bathroom-renovations': 'Waterproofed, ventilated, built to last.',
  'basement-renovations': 'Finished basements and legal suites.',
  'laneway-garden-suites': 'Backyard homes for family or rental.',
  'trades': 'Flooring, tile, drywall and paint.',
};
const workTitle: Record<string, string> = zh
  ? { 'custom-homes': '我们建造的定制住宅', 'kitchen-renovations': '我们完成的厨房', 'bathroom-renovations': '我们完成的浴室', 'home-renovations': '我们完成的全屋翻新' }
  : { 'custom-homes': 'Custom homes we’ve built', 'kitchen-renovations': 'Kitchens we’ve built', 'bathroom-renovations': 'Bathrooms we’ve built', 'home-renovations': 'Whole-home renovations we’ve done' };
const t = zh
  ? {
      services: '服务', book: '预约上门咨询', call: '致电', chip: 'EZU 完成的项目。', glance: '概览',
      weeks: (a: number, b: number) => [`${a}–${b} 周`, '：典型项目从第一次见面到完工'],
      quote: ['书面分项报价', '，上门看房后提供'], permits: ['许可证与政府检查', '由我们负责'],
      lang: ['普通话或英语', '，按您家人的习惯'], priced: '如何报价',
      includesH: '我们负责的工作', includesP: '全部包含在一份合同里，由专属项目团队管理。',
      processH: '项目如何进行', processP: '五个清晰的阶段，从第一次上门到最终验收。',
      timeH: '需要多长时间', timeP: '大多伦多地区同类项目的典型时间。许可证最难预测，尤其是需要小幅变更的时候。',
      knowH: '开工前要了解的', related: '相关项目', faqH: '常见问题',
      more: ['还有其他问题？', '我们的团队很乐意为您解答。'], ask: '咨询我们',
      reading: '延伸阅读', otherH: '其他服务', unsure: '不确定需要哪项服务？', unsureP: '告诉我们您的计划，我们来建议。',
    }
  : {
      services: 'Services', book: 'Book a consultation', call: 'Call', chip: 'A finished EZU project.', glance: 'At a glance',
      weeks: (a: number, b: number) => [`${a}–${b} weeks`, ' from first meeting to finish, for a typical project'],
      quote: ['A written, itemized quote', ' after we’ve seen the house'], permits: ['Permits and inspections', ' handled by us'],
      lang: ['English or Mandarin', ', whichever suits your family'], priced: 'How it’s priced',
      includesH: 'What we take care of', includesP: 'All of it under one contract, managed by a dedicated project team.',
      processH: 'How your project runs', processP: 'Five defined stages, from the first site visit to final sign-off.',
      timeH: 'How long it takes', timeP: 'Typical for this kind of project in the GTA. Permits are the least predictable part, especially if a variance is needed.',
      knowH: 'Good to know before you start', related: 'Related projects', faqH: 'Common questions',
      more: ['Have a question we didn’t cover?', ' Our team is happy to talk it through.'], ask: 'Ask us',
      reading: 'Further reading', otherH: 'Other services', unsure: 'Not sure which you need?', unsureP: 'Tell us your plans and we’ll advise.',
    };
const pre = zh ? '/zh' : '';
const contact = `${pre}/contact?service=${s.slug}`;
const weeks = s.timeline ? [s.timeline.reduce((a, x) => a + x.weeks[0], 0), s.timeline.reduce((a, x) => a + x.weeks[1], 0)] : null;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  description: s.description,
  provider: { '@id': `${site.url}/#org` },
  areaServed: ['Toronto', 'Markham', 'Richmond Hill', 'Vaughan'].map((name) => ({ '@type': 'City', name })),
  url: new URL(`${pre}/services/${s.slug}`, site.url).href,
  ...(zh ? { inLanguage: 'zh-Hans' } : {}),
};
---
<Base lang={lang} title={s.title} description={s.description} image={s.image} jsonld={[ld, faqLd]} alternate={{ en: `/services/${s.slug}`, zh: `/zh/services/${s.slug}` }}>
  <PageHero home={zh ? '首页' : undefined} crumbs={[{ href: zh ? '/zh#services' : '/services', label: t.services }, { label: s.name }]} title={s.name} lede={s.short} image={s.image} imageAlt={s.imageAlt} caption={s.imageIsProject ? t.chip : undefined} icon={s.slug}>
    <div class="btn-row">
      <a class="btn" href={contact}>{t.book}</a>
      <a class="btn btn--ghost" href={site.phoneHref}><Phone size={18} aria-hidden="true" />{t.call} {site.phone}</a>
    </div>
  </PageHero>

  <section class="section intro-section">
    <div class="wrap intro-grid">
      <div class="intro-main">
        <div class="prose">
          {s.intro.map((p) => <p>{p}</p>)}
        </div>
        <Photo class="intro-pic" src={s.introImage.src} alt={s.introImage.alt} caption={s.introImage.caption} ratio="3/2" sizes="(min-width: 1000px) 700px, 100vw" />
      </div>
      <aside class="glance" aria-label={t.glance}>
        <ul>
          {weeks && <li><Timer size={20} aria-hidden="true" /><span><strong>{t.weeks(weeks[0], weeks[1])[0]}</strong>{t.weeks(weeks[0], weeks[1])[1]}</span></li>}
          <li><FileText size={20} aria-hidden="true" /><span><strong>{t.quote[0]}</strong>{t.quote[1]}</span></li>
          <li><ClipboardCheck size={20} aria-hidden="true" /><span><strong>{t.permits[0]}</strong>{t.permits[1]}</span></li>
          <li><Languages size={20} aria-hidden="true" /><span><strong>{t.lang[0]}</strong>{t.lang[1]}</span></li>
        </ul>
        <p class="price-h">{t.priced}</p>
        <p class="price">{s.price}</p>
      </aside>
    </div>
  </section>

  <section class="section section--plaster">
    <div class="wrap">
      <div class="section-head"><h2>{t.includesH}</h2><p>{t.includesP}</p></div>
      <ul class="features">
        {s.includes.map((i) => <li><CircleCheck size={22} aria-hidden="true" /><div><h3>{i.title}</h3><p>{i.body}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="section trap-section">
    <div class="wrap"><div class="section-head"><h2>{t.processH}</h2><p>{t.processP}</p></div></div>
    <ProcessScroll tone="paper" lang={lang} finish={{ src: s.band.src, alt: s.band.alt }} />
  </section>

  {s.timeline && (
    <section class="section section--plaster">
      <div class="wrap">
        <div class="section-head"><h2>{t.timeH}</h2><p>{t.timeP}</p></div>
        <DimensionLine phases={s.timeline} lang={lang} />
      </div>
    </section>
  )}

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head"><h2>{t.knowH}</h2></div>
      <ul class="features">
        {s.know.map((k) => <li><Info size={22} aria-hidden="true" /><div><h3>{k.title}</h3><p>{k.body}</p></div></li>)}
      </ul>
    </div>
  </section>

  {work.length > 0 && (
    <section class="section section--plaster">
      <div class="wrap">
        <div class="section-head"><h2>{workTitle[s.slug] ?? t.related}</h2></div>
        <div class="cards">{work.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap faq-grid">
      <h2>{t.faqH}</h2>
      <div class="faq">
        {s.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p>{f.cta && <p class="faq-cta"><a class="text-link" href={contact}>{f.cta}</a></p>}</div>
          </details>
        ))}
        <div class="faq-more">
          <p><strong>{t.more[0]}</strong>{t.more[1]}</p>
          <div class="btn-row">
            <a class="btn" href={contact}>{t.ask}</a>
            <a class="btn btn--ghost" href={site.phoneHref}><Phone size={18} aria-hidden="true" />{t.call} {site.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section section--plaster section--tight">
      <div class="wrap">
        <h2 class="guides-title">{t.reading}</h2>
        <ArticleList items={guides} lang={lang} />
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="wrap">
      <h2 class="other-title">{t.otherH}</h2>
      <ul class="other">
        {others.map((o) => (
          <li><a href={`${pre}/services/${o.slug}`}><ServiceIcon slug={o.slug} size={28} /><span class="o-name">{zh ? o.zh : o.name}</span><span class="o-text">{zh ? servicesZh[o.slug].card : cardLine[o.slug]}</span></a></li>
        ))}
        <li><a class="o-cta" href={contact}><MessageSquare size={28} aria-hidden="true" /><span class="o-name">{t.unsure}</span><span class="o-text">{t.unsureP}</span></a></li>
      </ul>
    </div>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .intro-section { padding-top: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .intro-grid { display: grid; gap: 2.5rem 5rem; }
  @media (min-width: 1000px) { .intro-grid { grid-template-columns: minmax(0, 1fr) 22rem; } }
  .intro-grid .prose { font-size: var(--step-1); line-height: 1.6; max-width: 62ch; }
  .glance { align-self: start; background: var(--plaster); border-top: 3px solid var(--seal); padding: 1.5rem; }
  .glance ul { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: 0.9rem; }
  .glance li { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; align-items: start; line-height: 1.45; }
  .glance li :global(svg) { color: var(--seal); margin-top: 0.1rem; }
  .glance strong { font-weight: 650; }
  .price-h { margin: 0 0 0.3rem; padding-top: 1rem; border-top: 1px solid #d3d6d1; font-weight: 650; }
  .price { margin: 0; color: var(--ink-2); font-size: var(--step--1); line-height: 1.55; }
  .cards { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .trap-section { padding-bottom: 0; }
  .intro-main :global(.intro-pic) { margin-top: 2rem; max-width: var(--measure); }
  .faq-grid { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: 4fr 8fr; } }
  .guides-title { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .faq-cta { margin-top: 0.75rem !important; }
  .faq-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 2rem; padding: 1.25rem 1.5rem; background: var(--plaster); border-radius: var(--radius); }
  .faq-more p { margin: 0; text-wrap: balance; }
  .other-title { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .other { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .other { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .other { grid-template-columns: repeat(4, 1fr); } }
  .other a {
    display: grid; gap: 0.5rem; align-content: start; height: 100%; padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid #c9cdc8; border-radius: var(--radius); text-decoration: none; background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .other a :global(svg) { color: var(--seal); margin-bottom: 0.35rem; }
  .other .o-name { font-size: var(--step-1); font-weight: 650; line-height: 1.25; text-wrap: balance; }
  .other .o-text { color: var(--ink-2); font-size: var(--step-1); line-height: 1.4; text-wrap: balance; }
  .other a:hover { border-color: var(--seal); box-shadow: 0 8px 20px -12px rgba(30, 35, 38, 0.35); transform: translateY(-2px); }
  .other a:hover .o-name { color: var(--seal); }
  .other .o-cta { background: var(--plaster); border-color: var(--plaster); }
</style>
