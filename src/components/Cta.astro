---
import { Phone } from '@lucide/astro';
import { site } from '../data/site';
interface Props { title?: string; text?: string; lang?: 'en' | 'zh' }
const zh = Astro.props.lang === 'zh';
const {
  title = zh ? '有装修或建房计划？' : 'Have a project in mind?',
  text = zh ? '预约我们的团队上门咨询。我们会查看您的房子，和您一起讨论方案，然后提供详细的书面报价。' : 'Book a consultation with our team. We’ll assess your home, review the options with you and follow up with a detailed written quote.',
} = Astro.props;
---
<section class="cta">
  <div class="wrap inner">
    <div class="copy">
      <h2>{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="actions">
      <a class="btn" href={zh ? '/zh/contact' : '/contact'}>{zh ? '预约上门咨询' : 'Book a consultation'}</a>
      <a class="btn btn--ghost" href={site.phoneHref}><Phone size={18} aria-hidden="true" />{zh ? '致电' : 'Call'} {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--plaster); }
  .inner { display: grid; align-items: center; gap: 1.75rem 4rem; padding-block: clamp(3rem, 2rem + 3vw, 5rem); }
  @media (min-width: 900px) { .inner { grid-template-columns: 1fr auto; } }
  .copy .lede { margin: 0; max-width: 56ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
