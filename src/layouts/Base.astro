---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import defaultOg from '../assets/projects/etobicoke-kitchen-1.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  lang?: 'en' | 'zh';
  alternate?: { en: string; zh: string }; // paths for hreflang pairs
  noindex?: boolean;
  jsonld?: object | object[];
  fit?: boolean; // single-screen page: content fills the viewport, slim footer
}
const { title, description, image = defaultOg, type = 'website', lang = 'en', alternate, noindex = false, jsonld, fit = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const ogUrl = new URL(og.src, site.url).href;
// Google truncates titles past ~65 characters; long titles go without the brand suffix (the WebSite schema supplies the site name)
const fullTitle = title.includes('EZU') || title.length > 46 ? title : `${title} | EZU Construction`;

// One organization entity, referenced by @id from every other schema block on the site.
const org = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/logo.png`,
  image: ogUrl,
  telephone: '+1-647-766-9999',
  email: site.email,
  foundingDate: site.founded,
  priceRange: '$$$',
  knowsLanguage: ['en', 'zh'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.lat, longitude: site.address.lng },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '14:00' },
  ],
  areaServed: ['Toronto', 'Markham', 'Richmond Hill', 'Vaughan', 'York Region', 'Greater Toronto Area'].map((name) => ({ '@type': 'Place', name })),
  sameAs: Object.values(site.social),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, alternateName: 'EZU', url: `${site.url}/`, inLanguage: ['en-CA', 'zh-Hans'], publisher: { '@id': `${site.url}/#org` } };
const blocks = [org, ...(cleanPath === '/' ? [website] : []), ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternate && (
      <>
        <link rel="alternate" hreflang="en-CA" href={new URL(alternate.en, site.url).href} />
        <link rel="alternate" hreflang="zh-Hans" href={new URL(alternate.zh, site.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternate.en, site.url).href} />
      </>
    )}
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_CA'} />
    <meta name="twitter:card" content="summary_large_image" />

    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}

    <!-- Vercel Web Analytics + Speed Insights (cookieless, ~1 KB each, loaded after the page) -->
    <script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};window.si=window.si||function(){(window.siq=window.siq||[]).push(arguments)};</script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body class:list={{ fit }}>
    <a class="skip" href="#main">{lang === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer compact={fit} />
    <dialog class="lightbox" aria-label={lang === 'zh' ? '放大查看图片' : 'Enlarged photo'}>
      <button type="button" class="lb-close" aria-label={lang === 'zh' ? '关闭' : 'Close'}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      <figure><img alt="" /><figcaption></figcaption></figure>
    </dialog>
    <script is:inline>
      // Lightbox: click (or Enter) on any content photo that isn't a link opens it full screen at its largest size.
      (function () {
        var box = document.querySelector('.lightbox');
        if (!box || !box.showModal) return;
        var big = box.querySelector('img'), cap = box.querySelector('figcaption');
        var zoomable = function (img) { return img && img.tagName === 'IMG' && img.closest('main') && !img.closest('a, .media, [aria-hidden="true"]'); };
        var largest = function (img) {
          var best = img.currentSrc || img.src, w = 0;
          (img.getAttribute('srcset') || '').split(',').forEach(function (s) { var p = s.trim().split(/\s+/); var n = parseInt(p[1], 10) || 0; if (n > w) { w = n; best = p[0]; } });
          return best;
        };
        var open = function (img) {
          // Nearest caption up the tree (a photo's own, then its group's), prefixed with Before/After on comparisons
          var text = '', fig = img.closest('figure, .pic');
          while (fig && !text) {
            var c = fig.querySelector(':scope > figcaption, :scope > .chip');
            text = c ? c.textContent.trim() : '';
            fig = fig.parentElement && fig.parentElement.closest('figure');
          }
          var side = img.closest('.pair > div');
          var tag = side && side.querySelector('.tag');
          if (tag) text = tag.textContent.trim() + (text ? '\u00a0\u00a0|\u00a0\u00a0' + text : '');
          big.src = largest(img);
          big.alt = img.alt;
          cap.textContent = text;
          cap.hidden = !cap.textContent;
          box.showModal();
        };
        document.querySelectorAll('main img').forEach(function (img) {
          if (!zoomable(img)) return;
          img.classList.add('zoomable');
          img.tabIndex = 0;
          img.setAttribute('role', 'button');
          img.setAttribute('aria-label', (img.alt ? img.alt + '. ' : '') + 'Enlarge photo');
        });
        document.addEventListener('click', function (e) { var img = e.target.closest && e.target.closest('img.zoomable'); if (img) open(img); });
        document.addEventListener('keydown', function (e) { if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('zoomable')) { e.preventDefault(); open(e.target); } });
        box.addEventListener('click', function (e) { if (e.target !== big) box.close(); });
        box.addEventListener('close', function () { big.removeAttribute('src'); });
      })();
    </script>
    <script is:inline>
      // Tabs: ARIA tablist with arrow-key support. Without JavaScript every panel shows in sequence.
      document.querySelectorAll('[data-tabs]').forEach(function (root) {
        var tabs = [].slice.call(root.querySelectorAll('[role="tab"]'));
        var select = function (tab, focus) {
          tabs.forEach(function (t) {
            var on = t === tab;
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
          });
          if (focus) tab.focus();
        };
        tabs.forEach(function (t, i) {
          t.addEventListener('click', function () { select(t); });
          t.addEventListener('keydown', function (e) {
            var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
            if (n === null) return;
            e.preventDefault();
            select(tabs[(n + tabs.length) % tabs.length], true);
          });
        });
        select(tabs[0]);
      });
    </script>
    <script is:inline>
      // Fade-up as content enters the viewport. Runs before first paint, so content outside the hero
      // (including a row peeking in at the bottom of the first screen) starts hidden and rises in.
      // Nothing is hidden without JavaScript or with reduced motion.
      (function () {
        if (!matchMedia('(prefers-reduced-motion: no-preference)').matches || !('IntersectionObserver' in window)) return;
        // Content blocks: direct children of each .wrap; lists, grids and article bodies are split into their items.
        // Page heads (heroes, project and article headers) have their own load-in and are skipped.
        var skip = '.page-hero, main > .hero, .rise, .rise-late, .crumbs';
        var expand = function (el) {
          if (el.matches('.prose, .body, .story')) return [].concat.apply([], [].map.call(el.children, expand));
          if (el.matches('ul, ol, [class*="grid"]') && !el.closest('.prose')) return [].slice.call(el.children);
          return [el];
        };
        var els = [];
        document.querySelectorAll('main .wrap > *').forEach(function (el) { if (!el.closest(skip)) els = els.concat(expand(el)); });
        document.querySelectorAll('main .band, main .trap .media, main .trap .card').forEach(function (el) { els.push(el); });
        var io = new IntersectionObserver(function (entries) {
          entries.filter(function (e) { return e.isIntersecting; }).forEach(function (e, i) {
            e.target.style.transitionDelay = Math.min(i, 5) * 80 + 'ms';
            e.target.classList.add('in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -4% 0px' });
        els.forEach(function (el) { if (el.classList.contains('rv')) return; el.classList.add('rv'); io.observe(el); });
      })();
    </script>
  </body>
</html>
